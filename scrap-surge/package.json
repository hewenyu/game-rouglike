{
  "name": "scrap-surge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:browser:expedition": "node tests/browser-expedition.mjs",
    "test:browser:first-shop": "node tests/browser-first-shop.mjs",
    "test:browser:p2-items": "node tests/browser-p2-items.mjs",
    "test:browser:lifecycle": "node tests/browser-input-lifecycle.mjs",
    "test:astra:perf": "tsx tests/astra-perf.ts",
    "test:astra:ranged": "node tests/astra-ranged-run.mjs",
    "test:astra:heal-trace": "node tests/astra-heal-trace.cjs",
    "test:p3:measure": "tsx tests/p3-measure.ts",
    "format": "prettier --write src tests vite.config.ts",
    "test:browser:regression": "node tests/browser-regression.mjs",
    "test:browser:p2-visuals": "node tests/browser-p2-visuals.mjs",
    "test:browser:p2-lifecycle": "node tests/browser-p2-lifecycle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
